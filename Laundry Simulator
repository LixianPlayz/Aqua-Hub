local gui = Instance.new("ScreenGui", player.PlayerGui)

local function makeFrame(title, y)
	local frame = Instance.new("Frame", gui)
	frame.Size = UDim2.new(0,260,0,160)
	frame.Position = UDim2.new(0,10,0,y)
	frame.BackgroundColor3 = Color3.fromRGB(25,25,25)

	local titleLabel = Instance.new("TextLabel", frame)
	titleLabel.Size = UDim2.new(1,0,0,35)
	titleLabel.BackgroundTransparency = 1
	titleLabel.Text = title
	titleLabel.TextColor3 = Color3.new(1,1,1)
	titleLabel.TextSize = 20
	titleLabel.Font = Enum.Font.SourceSansBold

	return frame
end

local canBuyFrame = makeFrame("BEST YOU CAN BUY",50)
local nextFrame = makeFrame("NEXT",230)

local function clear(frame)
	for _,v in ipairs(frame:GetChildren()) do
		if v:IsA("TextLabel") and v ~= frame:FindFirstChildOfClass("TextLabel") then
			v:Destroy()
		end
	end
end

local function add(frame,w)
	local t = Instance.new("TextLabel", frame)
	t.Position = UDim2.new(0,0,0,35)
	t.Size = UDim2.new(1,0,0,100)
	t.BackgroundTransparency = 1
	t.TextColor3 = Color3.new(1,1,1)
	t.TextWrapped = true
	t.Font = Enum.Font.SourceSansBold
	t.TextSize = 22

	t.Text = string.format(
		"%s\nx%d | %ss | Cap:%d\n$%s",
		w[1],
		w[2],
		w[3],
		w[4],
		formatNumber(w.cost)
	)
end

--// =========================
--// LOOP
--// =========================
while true do
	task.wait(0.5)

	local money = getMoney()

	clear(canBuyFrame)
	clear(nextFrame)

	local best
	for _,w in ipairs(washers) do
		if money >= w.cost then
			best = w
		else
			break
		end
	end

	if best then
		add(canBuyFrame, best)
	end

	local nextW
	for _,w in ipairs(washers) do
		if money < w.cost then
			nextW = w
			break
		end
	end

	if nextW then
		add(nextFrame, nextW)

		local need = Instance.new("TextLabel", nextFrame)
		need.Position = UDim2.new(0,0,0,110)
		need.Size = UDim2.new(1,0,0,25)
		need.BackgroundTransparency = 1
		need.TextColor3 = Color3.fromRGB(255,100,100)
		need.TextSize = 20
		need.Font = Enum.Font.SourceSansBold

		need.Text = "Need: $" .. formatNumber(nextW.cost - money)
	end
end
