--// =========================
--// PARSE NUMBERS
--// =========================
local function parseNumber(str)
	str = tostring(str):lower()
	str = str:gsub("[^%d%.kmbt]", "")

	local num = tonumber(str:match("[%d%.]+"))
	if not num then return 0 end

	if str:find("k") then return num * 1e3 end
	if str:find("m") then return num * 1e6 end
	if str:find("b") then return num * 1e9 end
	if str:find("t") then return num * 1e12 end

	return num
end

--// =========================
--// FORMAT NUMBER (NEW)
--// =========================
local function formatNumber(n)
	n = tonumber(n) or 0

	if n < 100000 then
		return tostring(math.floor(n))
	end

	local function shorten(value)
		if value >= 1e12 then
			return string.format("%.2ft", value / 1e12)
		elseif value >= 1e9 then
			return string.format("%.2fb", value / 1e9)
		elseif value >= 1e6 then
			return string.format("%.2fm", value / 1e6)
		elseif value >= 1e3 then
			return string.format("%.2fk", value / 1e3)
		else
			return tostring(math.floor(value))
		end
	end

	return shorten(n)
end

